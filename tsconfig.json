{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "types": ["node"]

  },
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/browser-runtime" },
    { "path": "packages/node-runtime" }
  ],
  "exclude": ["dist/**", "build/**"]
}